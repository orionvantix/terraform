# Local .terraform directories
.terraform/

# *.tfstate files
*.tfstate
*.tfstate.*

# Crash log files
crash.log
crash.*.log

# Exclude all .tfvars files
*.tfvars
*.tfvars.json

# Ignore override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Ignore transient lock info files created by terraform apply
.terraform.tfstate.lock.info

# Ignore CLI configuration files
.terraformrc
terraform.rc

# --------------------------
# Extra recommended ignores
# --------------------------

# OSX junk (Mac auto-generated)
.DS_Store

# SSH keys & private material
*.pem
*.key

